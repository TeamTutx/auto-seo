# Local dev default is SQLite (zero setup). Point at Postgres for anything real:
# DATABASE_URL=postgresql+psycopg2://signal:signal@localhost:5432/signal
DATABASE_URL=sqlite:///./signal.db

SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Populated in later build steps (Stripe, rank provider, Claude, Google APIs).
# Not required for steps 1-3.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
