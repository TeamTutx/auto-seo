# Local dev default is SQLite (zero setup). Point at Postgres for anything real:
# DATABASE_URL=postgresql+psycopg2://signal:signal@localhost:5432/signal
DATABASE_URL=sqlite:///./signal.db

SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where the frontend runs - only used to build the redirect after the
# Google OAuth callback below.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (CORS). Must
# include the real frontend origin(s) in production - e.g.
# CORS_ORIGINS=https://signal-seo.in,https://www.signal-seo.in
CORS_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Required for keyword rank checks (POST/recheck /pages/{id}/keywords) -
# without credentials for whichever is active below, that endpoint returns a
# clean 502 instead of silently no-op'ing.
# RANK_PROVIDER picks which app/services/rank_providers implementation is
# used - "serpapi" or "dataforseo". Swapping vendors is just changing this
# value once both sets of credentials exist below.
RANK_PROVIDER=serpapi
SERPAPI_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Required for AI suggestions (POST /pages/{id}/suggestions/meta-description).
# AI_PROVIDER picks which app/services/ai_providers implementation is used -
# "openai" or "anthropic".
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# One OAuth client, two jobs - see backend/README.md for the Google Cloud
# Console steps. Unlike the vendor keys above this is an OAuth client, not a
# static key, and BOTH redirect URIs below must be registered on it exactly.
#  - GOOGLE_LOGIN_REDIRECT_URI: "Sign in with Google" (openid/email/profile
#    only). The consent screen must be PUBLISHED, or only your test users can
#    sign in.
#  - GOOGLE_REDIRECT_URI: connecting Search Console / Analytics, a separate
#    consent the user gives later from Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# Admin panel (/admin): comma-separated emails allowed in. Checked on every
# request - remove an email to revoke access. Empty = nobody is an admin.
ADMIN_EMAILS=

# Billing via Dodo Payments (merchant of record) - see backend/README.md
# "Billing & admin". Signal sells one-time credit packs, nothing recurring.
# Billing switches on only when BOTH keys are set. Start in test_mode; the
# webhook key is the signing secret of the webhook endpoint you create in Dodo
# pointing at <this API>/webhooks/dodo. DODO_BASE_URL overrides the API host
# (staging proxy / local mock) - leave empty normally.
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
DODO_BASE_URL=
