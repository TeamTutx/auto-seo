# Local dev default is SQLite (zero setup). Point at Postgres for anything real:
# DATABASE_URL=postgresql+psycopg2://signal:signal@localhost:5432/signal
DATABASE_URL=sqlite:///./signal.db

SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where the frontend runs - only used to build the redirect after the
# Google OAuth callback below.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (CORS). Must
# include the real frontend origin(s) in production - e.g.
# CORS_ORIGINS=https://signal-seo.in,https://www.signal-seo.in
CORS_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Required for keyword rank checks (POST/recheck /pages/{id}/keywords) -
# without credentials for whichever is active below, that endpoint returns a
# clean 502 instead of silently no-op'ing.
# RANK_PROVIDER picks which app/services/rank_providers implementation is
# used - "serpapi" or "dataforseo". Swapping vendors is just changing this
# value once both sets of credentials exist below.
RANK_PROVIDER=serpapi
SERPAPI_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Required for AI suggestions (POST /pages/{id}/suggestions/meta-description).
# AI_PROVIDER picks which app/services/ai_providers implementation is used -
# "openai" or "anthropic".
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required to connect Google Search Console / Analytics
# (POST /integrations/google/connect and everything under /pages/{id}/gsc,
# /pages/{id}/ga). Unlike the vendor keys above, this is an OAuth client, not
# a static key - see backend/README.md for the exact Google Cloud Console
# steps. GOOGLE_REDIRECT_URI must match a redirect URI registered on that
# OAuth client exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# Populated in a later build step (Stripe billing) - intentionally not
# integrated yet, see backend/README.md.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
